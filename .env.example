# Supabase / PostgreSQL connection strings (Pooling & Direct)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Minimum 32 characters random secret for signing session JWT tokens
JWT_SECRET="generate-a-strong-32-char-random-secret-here"

# Secret key to register or grant ADMIN role
ADMIN_SECRET_KEY="change-this-admin-secret-key"
